Checks:
    bugprone-*
    cppcoreguidelines-*
    modernize-*
    performance-*
    readability-*
    - *-redundant-access-specifiers
HeaderFileExtensions: [h, hpp]
ImplementationFileExtensions: [c, cc, cpp, cxx]
HeaderFilterRegex: (include|src)/
FormatStyle: file
CheckOptions:
    readability-identifier-length.IgnoredParameterNames: x|y|z
